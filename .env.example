# --- LLM (OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# Leave empty for the official OpenAI endpoint
OPENAI_API_BASE=
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-20b
# Model used for entity extraction (name, email, address) and RAGAS evaluation
EXTRACTOR_LLM_PROVIDER=openai
EXTRACTOR_LLM_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
# "huggingface" or "openai" (openai requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=huggingface
# Optional: leave empty to use the provider default
EMBEDDING_MODEL_NAME=

# --- SMTP (human escalation emails) ---
SMTP_PROVIDER=mailtrap
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@yourdomain.com

# --- API gateway ---
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8100

# Print agent steps (model calls, tool calls) to stdout: true/false
AGENT_VERBOSE=false
